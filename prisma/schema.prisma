generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paper {
  id            String   @id @default(cuid())
  title         String
  inputType     String
  content       String?
  pdfUrl        String?
  sourceUrl     String?
  status        String   @default("processing")
  result        Json?
  error         String?
  createdAt     DateTime @default(now())
}

